              "maximum": 180,
              "minimum": -180,
              "type": "number"
            }
          }
        ],
        "protocol": "http",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "forecast": {
                      "description": "Forecast for the next ~120 hours.",
