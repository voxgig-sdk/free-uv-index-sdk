                        "date",
                        "uvi"
                      ],
                      "type": "object"
                    },
                    "ok": {
                      "enum": [
                        true
                      ]
                    }
                  },
                  "required": [
                    "ok",
                    "latitude",
                    "longitude",
                    "now",
                    "forecast",
                    "history"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful operation"
          },
